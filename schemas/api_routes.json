{
    "routes": [
        {
            "method": "GET",
            "path": "/agent/{id}/graph",
            "response": "schemas/templates/graph_sample.json"
        },
        {
            "method": "GET",
            "path": "/agent/{id}/unexplored",
            "response": "schemas/templates/unexplored_sample.json"
        },
        {
            "method": "POST",
            "path": "/agent/{id}/simulate",
            "request": {
                "unexplored_state": "rollback_succeeded",
                "untried_action": "tool_timeout"
            },
            "response": "schemas/templates/scenario_19.json"
        },
        {
            "method": "POST",
            "path": "/scenarios/{id}/sandbox",
            "request": {
                "scenario_id": "sc_19"
            },
            "response": {
                "sandbox_id": "sb_07",
                "status": "running"
            }
        },
        {
            "method": "GET",
            "path": "/sandboxes/{id}",
            "response": {
                "sandbox_id": "sb_07",
                "status": "verified_fail",
                "log_s3": "s3://agentgarage/sandboxes/sb_07/log.jsonl",
                "invariants": {
                    "rollback_count": 2,
                    "active_version": "v1.8.1",
                    "last_known_good": "v1.8.2",
                    "checkout_available": false,
                    "verified_after_remediation": true,
                    "passed": false
                }
            }
        },
        {
            "method": "GET",
            "path": "/sandboxes",
            "response": {
                "sandboxes": []
            }
        },
        {
            "method": "POST",
            "path": "/sandboxes/{id}/promote",
            "response": {
                "compiled": true
            }
        },
        {
            "method": "GET",
            "path": "/traces",
            "response": {
                "traces": []
            }
        },
        {
            "method": "GET",
            "path": "/evals",
            "response": {
                "evals": [
                    "schemas/templates/eval_double_rollback.json"
                ]
            }
        },
        {
            "method": "POST",
            "path": "/evals/run",
            "request": {
                "agent_version": "1.8.3"
            },
            "response": {
                "passed": 1,
                "failed": 0
            }
        },
        {
            "method": "POST",
            "path": "/demo/seed",
            "request": {
                "runs": 5
            },
            "response": {
                "traces_written": 5
            }
        }
    ]
}